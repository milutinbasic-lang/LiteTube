<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon → "Log out". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_logout"
        android:shortcutId="logout"
        android:shortcutShortLabel="@string/log_out">
        <intent
            android:action="io.github.milutinbasic_lang.instachat.LOGOUT"
            android:targetClass="io.github.milutinbasic_lang.instachat.MainActivity"
            android:targetPackage="io.github.milutinbasic_lang.instachat" />
    </shortcut>
</shortcuts>
