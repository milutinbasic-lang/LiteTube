<?xml version="1.0" encoding="utf-8"?>
<!-- Only draws over the status bar: reads no window content. It listens for windows changing
     (app switches, dialogs) just to notice when an app goes fullscreen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/top_bar_service_description"
    android:notificationTimeout="100"
    android:summary="@string/top_bar_service_summary" />
